rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.admin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN");
    }

    // Public read for league information
    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Match and live scores
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Match Events: strictly admin created to preserve score integrity
    match /matchEvents/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lineups
    match /lineups/{lineupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Player Ratings: authenticated users can submit only their own rating once
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ratedByUserId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ratedByUserId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Awards and Announcements
    match /awards/{awardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.role == "USER";
      allow update: if isUser(userId) && request.resource.data.role == resource.data.role || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
